# Copie ces variables dans Vercel > ton projet > Settings > Environment Variables.
# Ne remplis JAMAIS ce fichier avec de vraies valeurs et ne le commite pas sur GitHub.

# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="otaku_sn"

# Génère une valeur unique à toi, par exemple avec: openssl rand -hex 32
JWT_SECRET="e27aa4ba90d15bfca06369e0b80e0ed7d1ae2479170f646e654d3cf3335e1a7a"

# Identifiants de connexion à l'espace admin (choisis les tiens)
ADMIN_EMAIL="admin@tondomaine.com"
ADMIN_PASSWORD="change-moi"

# Numéro WhatsApp par défaut pour la redirection panier (format international sans +)
WHATSAPP_NUMBER="221781920947"

# Laisse vide: en déploiement mono-domaine (frontend + API sur le même site Vercel),
# les requêtes se font sur le même domaine, donc CORS n'a pas besoin d'être restreint.
CORS_ORIGINS="*"

# URL publique de ton site une fois déployé (pour les liens de partage produit).
# Mets-la à jour une fois que Vercel t'a donné l'adresse définitive.
FRONTEND_URL="https://ton-site.vercel.app"

# Optionnel — uniquement nécessaire si tu gardes le bouton "uploader une image"
# dans l'admin (stockage géré par Emergent). Si tu ne remplis pas cette clé,
# ce bouton précis ne fonctionnera plus, MAIS tu peux toujours coller une URL
# d'image directement dans le champ "image" du formulaire produit (ça marche
# sans aucune config, par ex. un lien d'image hébergée ailleurs).
EMERGENT_LLM_KEY=""
